{
  "kind": "collectionType",
  "collectionName": "publics_cibles",
  "info": {
    "singularName": "public-cible",
    "pluralName": "publics-cibles",
    "displayName": "Public",
    "description": "Public visé : EHPAD, résidence autonomie, mairie, entreprise"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "ordre": {
      "type": "integer",
      "default": 0
    },
    "ateliers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::atelier.atelier",
      "mappedBy": "publics"
    }
  }
}
